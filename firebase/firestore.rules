rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{uid}/backups/main {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && validBackup() && request.resource.data.version == 1;
      allow update: if request.auth != null && request.auth.uid == uid
        && validBackup() && request.resource.data.version == resource.data.version + 1;
      function validBackup() {
        return request.resource.data.keys().hasOnly(['version','payload','updatedAt'])
          && request.resource.data.version is int
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 900000
          && request.resource.data.updatedAt == request.time;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
